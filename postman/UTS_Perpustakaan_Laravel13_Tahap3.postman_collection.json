                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"run_tag\", Date.now().toString() + \"-\" + Math.random().toString(36).slice(2, 8));",
                  "pm.collectionVariables.set(\"id_kategori\", \"\");",
                  "pm.collectionVariables.set(\"id_buku\", \"\");",
                  "pm.variables.set(\"run_tag\", pm.collectionVariables.get(\"run_tag\"));"
